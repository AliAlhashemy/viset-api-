PORT=3000
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
# For local SQLite: leave TURSO_URL unset (defaults to file:./data/viset.db)
# For Turso cloud: TURSO_URL=libsql://your-db.turso.io
# TURSO_URL=file:./data/viset.db
# TURSO_TOKEN=your-turso-auth-token
DB_PATH=./data/viset.db
ADMIN_PASSWORD="change-this-to-a-strong-password"
UPLOAD_DIR=./uploads
# CORS_ORIGIN=https://yourdomain.com,https://anotherdomain.com
